    "properties": {
      "diagnostic_id": {"type": "string", "pattern": "^ccc-thread-diag-v1-[a-z0-9]{8,32}$", "maxLength": 51},
      "expected_source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40}
